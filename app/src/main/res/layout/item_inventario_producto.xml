<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Imagen -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/borde_card"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivProducto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/fondo_general" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Nombre + código -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.45"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coca Cola 500ml"
                android:textColor="@color/texto_principal"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17454111774"
                android:textColor="@color/texto_secundario"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Descripción / precio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.25"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/. 2.50"
                android:textColor="@color/verde_ganancia"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Stock + botón + -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.15"
            android:orientation="vertical"
            android:gravity="end|center_vertical">

            <!-- Botón chevron detalle -->
            <ImageView
                android:id="@+id/ivDetalle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_media_next"
                app:tint="@color/texto_secundario"
                android:layout_marginBottom="4dp"
                android:layout_gravity="end" />

            <!-- Stock -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="end">

                <TextView
                    android:id="@+id/tvStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50 unds"
                    android:textColor="@color/texto_secundario"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSumarStock"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="0dp"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconSize="14dp"
                    app:iconTint="@color/texto_sobre_verde"
                    app:iconPadding="0dp"
                    app:backgroundTint="@color/verde_nav"
                    app:cornerRadius="6dp"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:contentDescription="Sumar stock" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borde_card"
        android:layout_marginHorizontal="16dp" />

</LinearLayout>
