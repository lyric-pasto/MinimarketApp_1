<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_general">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/verde_nav"
            app:navigationIcon="@drawable/icono_regresar_pantalla"
            app:navigationIconTint="@color/texto_sobre_verde"
            app:title="Gestión de Proveedores"
            app:titleTextColor="@color/texto_sobre_verde"/>

        <!-- Buscador de Proveedores -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="@color/morado_scanner"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxBackgroundColor="@color/fondo_card"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscarProveedor"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:paddingVertical="0dp"
                android:hint="Buscar proveedor por nombre o RUC..."
                android:textSize="13sp"
                android:textColor="@color/texto_principal"/>
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProveedores"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        <!-- Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@color/verde_nav"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:itemActiveIndicatorStyle="@null"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregarProveedor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="78dp"
        android:contentDescription="Agregar Proveedor"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/amarillo_accion"
        app:tint="@color/texto_sobre_amarillo" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
