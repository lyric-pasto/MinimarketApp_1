<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardProductoArchivo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/fondo_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- IMAGEN DEL PRODUCTO / ARCHIVO -->
        <ImageView
            android:id="@+id/ivProductoArchivo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_product_placeholder" />

        <!-- INFORMACIÓN DEL PRODUCTO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreProductoArchivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nombre del Producto"
                android:textColor="@color/texto_principal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPrecioProductoArchivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 5.00"
                    android:textColor="@color/verde_ganancia"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStockProductoArchivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Stock: 20 u"
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTipoVentaBadgeArchivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_rol"
                    android:backgroundTint="@color/morado_scanner"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="⚖️ KG"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- BOTÓN EDITAR LÁPIZ -->
        <ImageButton
            android:id="@+id/btnEditarProductoArchivo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar producto"
            android:src="@drawable/ic_edit_pencil"
            app:tint="@color/morado_scanner" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
