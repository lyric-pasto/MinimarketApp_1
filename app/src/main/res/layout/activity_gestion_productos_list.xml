<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_general">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOOLBAR -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarGestionProductos"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/fondo_card"
            app:navigationIcon="@drawable/icono_regresar_pantalla"
            app:navigationIconTint="@color/texto_principal"
            app:title="Catálogo de Productos"
            app:titleTextColor="@color/texto_principal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />

        <!-- BARRA DE BÚSQUEDA -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchGestionProductos"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_buscador"
            app:iconifiedByDefault="false"
            app:queryBackground="@android:color/transparent"
            app:queryHint="Buscar producto por nombre o código..." />

        <TextView
            android:id="@+id/tvConteoProductosTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:text="Cargando productos..."
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />

        <!-- LISTA DE PRODUCTOS CON EDICIÓN -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGestionProductos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

    </LinearLayout>

    <!-- FAB NUEVO PRODUCTO -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNuevoProducto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="Nuevo Producto"
        android:textColor="@color/white"
        app:backgroundTint="@color/morado_scanner"
        app:icon="@drawable/icono_boton_agregar"
        app:iconTint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
