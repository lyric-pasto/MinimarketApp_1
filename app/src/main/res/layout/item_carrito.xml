<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/fondo_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Imagen del Producto (Glide) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProducto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_product_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

        <!-- Nombre y Precio unitario -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre Producto"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 0.00 c/u"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvSubtotalLinea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 0.00"
                android:textColor="@color/verde_ganancia"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Controles - / + en fila horizontal -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="0dp"
                android:text="−"
                android:textSize="16sp"
                app:backgroundTint="@color/borde_card"
                android:textColor="@color/texto_principal"
                app:cornerRadius="8dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

            <TextView
                android:id="@+id/tvCantidad"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:gravity="center"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSumar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="16sp"
                app:backgroundTint="@color/verde_nav"
                android:textColor="@color/texto_sobre_verde"
                app:cornerRadius="8dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

            <ImageButton
                android:id="@+id/btnEliminar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/rojo_alerta"
                android:contentDescription="Eliminar"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
