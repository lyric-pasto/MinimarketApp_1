<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_general"
    tools:context=".punto_venta">

    <!-- CONTENIDO PRINCIPAL CON ESPACIO PARA LA BARRA INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginBottom="60dp">

        <!-- HEADER: título + badge rol + botones admin/salida -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:background="@color/fondo_card">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreUsuarioHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Punto de Venta"
                    android:textColor="@color/texto_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRolUsuarioHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VENDEDOR"
                    android:textColor="@color/verde_ganancia"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Botón Gestión Usuarios con Badge de Notificación (Visible solo para ADMIN) -->
            <FrameLayout
                android:id="@+id/layoutBtnGestionUsuarios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp">

                <ImageButton
                    android:id="@+id/btnGestionUsuarios"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Gestión de Usuarios"
                    android:src="@drawable/ic_usuario"
                    app:tint="@color/morado_scanner"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tvBadgeUsuarios"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_boton_redondo"
                    android:backgroundTint="@color/rojo_alerta"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Botón Cerrar Sesión / Salir -->
            <ImageButton
                android:id="@+id/btnCerrarSesion"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar Sesión"
                android:src="@drawable/icono_regresar_pantalla"
                app:tint="@color/rojo_alerta"
                android:padding="8dp" />

        </LinearLayout>

        <!-- BARRA DE BÚSQUEDA + BOTÓN ESCÁNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchProductos"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                app:iconifiedByDefault="false"
                app:queryHint="Buscar por nombre o código..."
                app:searchIcon="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/btnEscanear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_boton_redondo"
                android:src="@drawable/ic_barcode_scanner"
                android:contentDescription="Escanear código de barras"
                android:padding="10dp" />

        </LinearLayout>

        <!-- CHIPS DE CATEGORÍAS (Single Selection ChipGroup con scroll horizontal) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodos"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:checked="true"
                    android:text="Todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAbarrotes"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Abarrotes" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLacteos"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Lácteos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBebidas"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Bebidas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLimpieza"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Limpieza" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSnacks"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Snacks" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCuidadoPersonal"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Cuidado Personal" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- CONTADOR DE PRODUCTOS DISPONIBLES -->
        <TextView
            android:id="@+id/tvCantidadProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="6dp"
            android:text="Productos disponibles"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />

        <!-- LISTA DE PRODUCTOS CON SCROLL COMPLETO -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProductos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_producto" />

    </LinearLayout>

    <!-- MENÚ INFERIOR FIJO -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:background="@color/verde_nav"
        app:elevation="8dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:itemActiveIndicatorStyle="@null"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
