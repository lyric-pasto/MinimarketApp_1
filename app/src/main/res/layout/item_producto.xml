<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/borde_card"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/fondo_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Imagen producto -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/borde_card"
            app:strokeWidth="1dp"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/ivProducto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_product_placeholder" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del producto"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoría"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/. 0.00"
                android:textColor="@color/verde_ganancia"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- Botón agregar al carrito -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="0dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconSize="20dp"
            app:iconTint="@color/texto_sobre_verde"
            app:iconPadding="0dp"
            app:backgroundTint="@color/verde_nav"
            app:cornerRadius="10dp"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:contentDescription="Agregar al carrito" />

        <!-- Icono/Boton Editar Producto -->
        <ImageView
            android:id="@+id/ivDetalle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="@color/texto_secundario"
            android:contentDescription="Editar Producto" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>